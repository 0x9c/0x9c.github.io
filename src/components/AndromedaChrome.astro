---
import site from '../data/site.json';
import { andromeda } from '../data/andromedaSettings';
import navigation from '../data/navigation.json';
import AndromedaIcon from './AndromedaIcon.astro';
import '../styles/andromeda.css';
import { themeHref, type ThemeId } from '../utils/themes';

interface Props {
  previewTheme?: ThemeId;
}
const { previewTheme } = Astro.props;
const homeHref = themeHref('/', previewTheme);
const feedHref = themeHref('/feed/', previewTheme);
// This Astro theme is inspired by Andrômeda by kosmique (https://kosmique.tumblr.com/).
---

<div class:list={['andromeda-theme', { 'andromeda-sidebar-right': andromeda.sidebarRight }]} style={`--andromeda-post-width:${andromeda.postWidth}px;--andromeda-font-size:${andromeda.fontSize}px;--andromeda-font-family:${andromeda.fontFamily}`}>
  <div class="andromeda-shell">
    <header class="andromeda-header">
      <form class="andromeda-search" data-andromeda-search role="search" action={feedHref}>
        <AndromedaIcon name="search" /><input type="search" name="q" placeholder="검색어를 입력하세요" aria-label="글 검색" />
      </form>
      <nav class="andromeda-header-actions" aria-label="빠른 메뉴">
        <a href={homeHref} aria-label="홈" title="홈"><AndromedaIcon name="home" /></a>
        <a href={feedHref} aria-label="글 피드" title="글 피드"><AndromedaIcon name="archive" /></a>
        <button type="button" data-andromeda-open aria-haspopup="dialog" aria-expanded="false" aria-controls="andromeda-drawer" aria-label="메뉴 열기" title="메뉴 열기"><AndromedaIcon name="menu" /></button>
      </nav>
    </header>
    <div class="andromeda-layout">
      <aside class="andromeda-profile">
        <div class="andromeda-banner" style={andromeda.banner ? `background-image:url('${andromeda.banner.replace(/['()\\]/g, '')}')` : undefined}></div>
        <div class="andromeda-profile-content">
          <a class="andromeda-avatar" href={homeHref} aria-label={`${site.title} 홈`}>{andromeda.avatar ? <img src={andromeda.avatar} alt="" /> : site.title.slice(0, 1)}</a>
          <h1>{site.title}</h1><p class="andromeda-handle"><AndromedaIcon name="at" /> {andromeda.handle}</p>
          <p class="andromeda-profile-description">{site.description}</p>
        </div>
      </aside>
      <main id="content" class="andromeda-main"><slot /></main>
    </div>
    <footer class="andromeda-footer">© {new Date().getFullYear()} {site.title} · <a href="/rss.xml">RSS</a></footer>
  </div>
  <dialog class="andromeda-drawer" id="andromeda-drawer" aria-label="블로그 메뉴">
    <button type="button" class="andromeda-close" data-andromeda-close aria-label="메뉴 닫기" autofocus><span><AndromedaIcon name="close" /></span><span>닫기</span></button>
    <div class="andromeda-drawer-content">
      <form class="andromeda-search andromeda-drawer-search" data-andromeda-search role="search" action={feedHref}>
        <input type="search" name="q" placeholder="검색어를 입력하세요" aria-label="글 검색" />
      </form>
      <a class="andromeda-avatar" href={homeHref} aria-label={`${site.title} 홈`}>{andromeda.avatar ? <img src={andromeda.avatar} alt="" /> : site.title.slice(0, 1)}</a>
      <h2>{site.title}</h2><p class="andromeda-handle"><AndromedaIcon name="at" /> {andromeda.handle}</p>
      {andromeda.details.length > 0 && (
        <dl class="andromeda-profile-details" aria-label="프로필 정보">
          {andromeda.details.map(({ label, value, icon }) => (
            <div title={label}>
              <dt class:list={{ 'detail-label-hidden': !!icon }}>{label}</dt>
              <dd><AndromedaIcon name={icon ?? 'sparkle'} /><span>{value}</span></dd>
            </div>
          ))}
        </dl>
      )}
      <nav aria-label="전체 메뉴">
        {!navigation.items.some((item) => item.href === '/') && <a href={homeHref}>홈</a>}
        {navigation.items.map((item) => <a href={themeHref(item.href, previewTheme)}>{item.label}</a>)}
      </nav>
    </div>
  </dialog>
</div>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('.andromeda-drawer');
  const openButton = document.querySelector<HTMLButtonElement>('[data-andromeda-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-andromeda-close]');
  openButton?.addEventListener('click', () => {
    if (!drawer) return;
    drawer.showModal();
    openButton.setAttribute('aria-expanded', 'true');
  });
  closeButton?.addEventListener('click', () => drawer?.close());
  drawer?.addEventListener('close', () => openButton?.setAttribute('aria-expanded', 'false'));
  drawer?.addEventListener('click', (event) => {
    if (event.target === drawer && event.clientX >= drawer.getBoundingClientRect().right) drawer.close();
  });

  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('[data-andromeda-search]'));
  const inputs = forms.map((form) => form.querySelector<HTMLInputElement>('input')).filter((input): input is HTMLInputElement => input !== null);
  let term = new URLSearchParams(window.location.search).get('q') || '';
  // Searches bookmarked before the feed moved still open the full-text results.
  if (term.trim() && document.querySelector('[data-andromeda-index]')) {
    const target = new URL(window.location.href);
    target.pathname = target.pathname.replace(/\/?$/, '/feed/');
    window.location.replace(target.href);
  }
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-andromeda-post]'));
  const empty = document.querySelector<HTMLElement>('[data-andromeda-search-empty]');
  const pagination = document.querySelector<HTMLElement>('[data-andromeda-pagination]');
  const prev = document.querySelector<HTMLButtonElement>('[data-andromeda-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-andromeda-next]');
  const pageLabel = document.querySelector<HTMLElement>('[data-andromeda-page]');
  let page = 1;
  function updateFeed() {
    const query = term.trim().toLocaleLowerCase();
    const matching = cards.filter((card) => (card.textContent || '').toLocaleLowerCase().includes(query));
    const pages = Math.max(1, Math.ceil(matching.length / 6));
    page = Math.min(page, pages);
    cards.forEach((card) => { card.hidden = !matching.slice((page - 1) * 6, page * 6).includes(card); });
    if (empty) empty.hidden = matching.length > 0 || !query;
    if (pagination) pagination.hidden = pages <= 1;
    if (pageLabel) pageLabel.textContent = `${page} / ${pages}`;
    if (prev) prev.disabled = page <= 1;
    if (next) next.disabled = page >= pages;
  }
  inputs.forEach((input) => { input.value = term; });
  if (cards.length) {
    forms.forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); page = 1; updateFeed(); if (drawer?.open) drawer.close(); }));
    inputs.forEach((input) => input.addEventListener('input', () => { term = input.value; inputs.forEach((other) => { if (other !== input) other.value = term; }); page = 1; updateFeed(); }));
    prev?.addEventListener('click', () => { page--; updateFeed(); });
    next?.addEventListener('click', () => { page++; updateFeed(); });
    updateFeed();
  }
</script>
