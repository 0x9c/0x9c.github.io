---
import { render } from 'astro:content';
import { getPublishedPosts } from '../utils/posts';
import CodeBlocks from './CodeBlocks.astro';
import AndromedaIcon from './AndromedaIcon.astro';
import AndromedaPost from './AndromedaPost.astro';
import type { ThemeId } from '../utils/themes';

interface Props {
  previewTheme?: ThemeId;
}
const { previewTheme } = Astro.props;

const posts = await getPublishedPosts();
const entries = await Promise.all(posts.map(async (post) => ({
  post,
  Content: (await render(post)).Content,
})));
---

<div class="andromeda-feed" data-andromeda-feed>
  {entries.map(({ post, Content }) => (
    <AndromedaPost post={post} previewTheme={previewTheme}><Content /></AndromedaPost>
  ))}
  {!posts.length && <p class="andromeda-empty">아직 작성된 글이 없습니다.</p>}
  <p class="andromeda-empty" data-andromeda-search-empty hidden>검색 결과가 없습니다.</p>
  <div class="andromeda-pagination" data-andromeda-pagination hidden>
    <button type="button" data-andromeda-prev><AndromedaIcon name="arrow-left" /> 이전</button><span data-andromeda-page></span><button type="button" data-andromeda-next>다음 <AndromedaIcon name="arrow-right" /></button>
  </div>
</div>
<CodeBlocks />
