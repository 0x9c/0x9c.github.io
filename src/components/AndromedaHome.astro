---
import { render } from 'astro:content';
import site from '../data/site.json';
import { formatDate, getPostCover, getPublishedPosts } from '../utils/posts';
import CodeBlocks from './CodeBlocks.astro';
import AndromedaIcon from './AndromedaIcon.astro';

const posts = await getPublishedPosts();
const entries = await Promise.all(posts.map(async (post) => ({
  post,
  cover: getPostCover(post, 'andromeda'),
  Content: (await render(post)).Content,
})));
---

<div class="andromeda-feed" data-andromeda-feed>
  {entries.map(({ post, cover, Content }) => (
    <article class="andromeda-post" data-andromeda-post>
      <div class="andromeda-post-top">
        <a class="andromeda-post-author" href="/">{site.title}</a>
      </div>
      {post.data.gallery?.length ? (
        <div class:list={['andromeda-gallery', { 'andromeda-gallery-single': post.data.gallery.length === 1 }]}>
          {post.data.gallery.map((image, index) => <a href={image} target="_blank" rel="noopener noreferrer"><img src={image} alt={`${post.data.title} 사진 ${index + 1}`} loading="lazy" /></a>)}
        </div>
      ) : cover ? (
        <a class="andromeda-cover" href={`/blog/${post.id}/`}><img src={cover} alt={post.data.coverAlt || post.data.title} /></a>
      ) : null}
      <div class="andromeda-post-body">
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        {post.data.description && <p class="andromeda-post-description">{post.data.description}</p>}
        {post.data.audioUrl && <audio controls preload="none" src={post.data.audioUrl}>브라우저에서 오디오 재생을 지원하지 않습니다.</audio>}
        <div class="prose andromeda-prose"><Content /></div>
      </div>
      <div class="andromeda-post-footer">
        <a href={`/blog/${post.id}/`} class="andromeda-post-date">{formatDate(post.data.pubDate)}</a>
        <a class="andromeda-read-link" href={`/blog/${post.id}/`}>글 자세히 보기</a>
      </div>
    </article>
  ))}
  {!posts.length && <p class="andromeda-empty">아직 작성된 글이 없습니다.</p>}
  <p class="andromeda-empty" data-andromeda-search-empty hidden>검색 결과가 없습니다.</p>
  <div class="andromeda-pagination" data-andromeda-pagination hidden>
    <button type="button" data-andromeda-prev><AndromedaIcon name="arrow-left" /> 이전</button><span data-andromeda-page></span><button type="button" data-andromeda-next>다음 <AndromedaIcon name="arrow-right" /></button>
  </div>
</div>
<CodeBlocks />
