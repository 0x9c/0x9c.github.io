---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AndromedaPost from './AndromedaPost.astro';
import CodeBlocks from './CodeBlocks.astro';
import PostMedia from './PostMedia.astro';
import YouTubeVideo from './YouTubeVideo.astro';
import site from '../data/site.json';
import { formatDate, getPostCover } from '../utils/posts';
import { themeHref, type ThemeId } from '../utils/themes';

interface Props {
  post: CollectionEntry<'blog'>;
  previewTheme?: ThemeId;
}

const { post, previewTheme } = Astro.props;
const theme = previewTheme ?? site.theme;
const isAstroTheme = theme === 'astro-blog' || theme === 'astro-paper';
const cover = getPostCover(post, theme);
const blogUrl = themeHref('/', previewTheme);
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={cover} theme={previewTheme} noindex={!!previewTheme}>
  {theme === 'andromeda' ? (
    <AndromedaPost post={post} previewTheme={previewTheme} detail><Content /></AndromedaPost>
  ) : (
    <article class="article-shell">
      <a class="back-link" href={blogUrl}>모든 글</a>
      <header class="article-heading">
        {!isAstroTheme && <p class="eyebrow">JOURNAL ENTRY</p>}
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="article-description">{post.data.description}</p>}
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      </header>
      {cover && <img class="article-cover" src={cover} alt={post.data.coverAlt || ''} />}
      <YouTubeVideo url={post.data.youtubeUrl} title={post.data.title} />
      <PostMedia title={post.data.title} gallery={post.data.gallery} audioUrl={post.data.audioUrl} />
      <div class="prose"><Content /></div>
      <div class="article-end">
        {!isAstroTheme && <span aria-hidden="true">✳</span>}
        <a href={blogUrl}>{isAstroTheme ? '글 목록으로' : '다른 기록 보기'}</a>
      </div>
    </article>
  )}
  <CodeBlocks />
</BaseLayout>
