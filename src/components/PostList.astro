---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getPostCover } from '../utils/posts';
import site from '../data/site.json';
import { themeHref, type ThemeId } from '../utils/themes';

interface Props {
  posts: CollectionEntry<'blog'>[];
  theme?: string;
  previewTheme?: ThemeId;
}

const { posts, previewTheme, theme = previewTheme ?? site.theme } = Astro.props;
const entries = posts.map((post) => ({
  post,
  cover: getPostCover(post, theme),
  href: themeHref(`/blog/${post.id}/`, previewTheme),
}));
---

{posts.length ? (
  <div class="post-list">
    {entries.map(({ post, cover, href }) => (
      <article class:list={['post-row', { 'has-cover': cover }]}>
        <div class="post-copy">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h3><a href={href}>{post.data.title}</a></h3>
          {post.data.description && <p>{post.data.description}</p>}
          <a class="text-link" href={href} aria-label={`${post.data.title} 읽기`}>글 읽기</a>
        </div>
        {cover && (
          <a class="post-cover" href={href} tabindex="-1" aria-hidden="true">
            <img src={cover} alt="" loading="lazy" />
          </a>
        )}
      </article>
    ))}
  </div>
) : (
  <div class="empty-state"><p>아직 공개된 글이 없습니다.</p></div>
)}
