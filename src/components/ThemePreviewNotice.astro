---
import type { ThemeId } from '../utils/themes';

interface Props { theme: { id: ThemeId; name: string } }
const { theme } = Astro.props;
---

<aside class="preview-bar" data-preview-notice aria-label="테마 미리보기">
  <div class="shell preview-bar-inner">
    <p><strong>{theme.name}</strong> 미리보기</p>
  </div>
</aside>

<style>
  :global(.andromeda-main) > .preview-bar { margin-block-start: 16px; }
</style>
