---
interface Props {
  url?: string | null;
  title: string;
}

const { url, title } = Astro.props;
function videoId(value: string) {
  const link = URL.parse(value);
  if (!link || link.protocol !== 'https:') return;
  let id: string | null | undefined;
  if (link.hostname === 'youtu.be') {
    id = link.pathname.slice(1);
  } else if (['youtube.com', 'www.youtube.com', 'music.youtube.com', 'm.youtube.com', 'www.youtube-nocookie.com'].includes(link.hostname)) {
    id = link.pathname === '/watch'
      ? link.searchParams.get('v')
      : link.pathname.match(/^\/(?:shorts|live|embed)\/([^/]+)\/?$/)?.[1];
  }
  return id && /^[\w-]{11}$/.test(id) ? id : undefined;
}

const id = url && videoId(url.trim());
---

{id && <iframe
  class="post-video"
  src={`https://www.youtube-nocookie.com/embed/${id}`}
  title={`${title} · YouTube`}
  loading="lazy"
  referrerpolicy="strict-origin-when-cross-origin"
  allow="encrypted-media; fullscreen; picture-in-picture"
  allowfullscreen
></iframe>}

<style>
  .post-video { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 5px; }
</style>
