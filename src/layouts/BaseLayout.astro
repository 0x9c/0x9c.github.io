---
import navigation from '../data/navigation.json';
import site from '../data/site.json';
import { findTheme, themeHref, type ThemeId } from '../utils/themes';
import AndromedaChrome from '../components/AndromedaChrome.astro';
import ThemePreviewNotice from '../components/ThemePreviewNotice.astro';
import LiveTheme from '../components/LiveTheme.astro';
import '../styles/global.css';
import '../styles/astro-starter.css';
import '../styles/astro-paper.css';
import '../styles/andromeda.css';
import '../styles/andromeda-fonts.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  theme?: ThemeId;
  noindex?: boolean;
}

const { title, description = site.description, image, theme: previewTheme, noindex = false } = Astro.props;
const theme = findTheme(previewTheme ?? site.theme);
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const path = previewTheme ? Astro.url.pathname.slice(`/themes/${previewTheme}`.length) || '/' : Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const socialImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ko" data-theme={theme.id} data-preview-theme={previewTheme} data-public-title={path === '/' ? site.title : pageTitle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="theme-color" content={theme.color} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
    <title>{pageTitle}</title>
    <LiveTheme />
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    {theme.id === 'andromeda' ? <AndromedaChrome previewTheme={previewTheme}>
      <slot />
      {previewTheme && <ThemePreviewNotice theme={theme} />}
    </AndromedaChrome> : <>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={themeHref('/', previewTheme)} aria-label={`${site.title} 홈`}>
          <span class="brand-mark" aria-hidden="true">✳</span>
          <span>{site.title}<span class="brand-dot">.</span></span>
        </a>
        <nav class="main-nav" aria-label="주 메뉴">
          {navigation.items.map((item) => {
            const active = item.href === '/' ? path === '/' || path.startsWith('/blog/') : item.href.startsWith('/') && path.startsWith(item.href);
            return <a href={themeHref(item.href, previewTheme)} aria-current={active ? 'page' : undefined}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="content">
      {previewTheme && <ThemePreviewNotice theme={theme} />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="footer-brand" href={themeHref('/', previewTheme)}>{site.title}<span class="brand-dot">.</span></a>
          <p>{site.description}</p>
        </div>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/0x9c" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="shell footer-bottom">© {new Date().getFullYear()} {site.title}</div>
    </footer>
    </>}
    <script>
      import { themeHref, themes } from '../utils/themes';

      // Markdown is shared by the public site and every preview. Resolve its links in the open view.
      const selected = themes.find(({ id }) => id === document.documentElement.dataset.previewTheme);
      if (selected && !document.documentElement.hasAttribute('data-live-theme')) {
        const prefix = `/themes/${selected.id}`;
        const publicPage = new URL(location.pathname.slice(prefix.length) || '/', location.origin);
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.prose a[href]')) {
          const href = link.getAttribute('href');
          if (!href || href.startsWith('#') || link.hasAttribute('download')) continue;
          const base = new URL(link.closest<HTMLElement>('[data-entry-path]')?.dataset.entryPath || publicPage.href, publicPage);
          const url = URL.parse(href, base);
          if (url?.origin !== publicPage.origin) continue;
          const path = url.pathname + url.search + url.hash;
          const scoped = themeHref(path, selected.id);
          if (scoped !== path) link.href = scoped;
        }
      }
    </script>
  </body>
</html>
