---
import navigation from '../data/navigation.json';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="theme-color" content="#f7faf9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label={`${site.title} 홈`}>
          <span class="brand-mark" aria-hidden="true">✳</span>
          <span>{site.title}<span class="brand-dot">.</span></span>
        </a>
        <nav class="main-nav" aria-label="주 메뉴">
          {navigation.items.map((item) => {
            const active = item.href.startsWith('/') && (path === item.href || (item.href !== '/' && path.startsWith(item.href)));
            return <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="footer-brand" href="/">{site.title}<span class="brand-dot">.</span></a>
          <p>{site.description}</p>
        </div>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/0x9c" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">관리</a>
        </div>
      </div>
      <div class="shell footer-bottom">© {new Date().getFullYear()} {site.title}</div>
    </footer>
  </body>
</html>
