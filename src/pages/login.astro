---
import { authOrigin, blogAdminAuth, editorUrl } from '../utils/admin';

const destination = blogAdminAuth ? `${authOrigin}/auth/login` : editorUrl;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>블로그 관리 로그인</title>
  </head>
  <body>
    <p><a href={destination}>{blogAdminAuth ? 'GitHub로 로그인' : 'Pages CMS에서 블로그 관리 열기'}</a></p>
  </body>
</html>
