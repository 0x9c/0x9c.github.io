---
import BlogIndexRedirect from '../../../../components/BlogIndexRedirect.astro';
import { themes } from '../../../../utils/themes';

export function getStaticPaths() {
  return themes.map(({ id }) => ({ params: { theme: id }, props: { previewTheme: id } }));
}
---

<BlogIndexRedirect previewTheme={Astro.props.previewTheme} />
