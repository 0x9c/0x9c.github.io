---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AndromedaIcon from '../../components/AndromedaIcon.astro';
import site from '../../data/site.json';
import { andromeda } from '../../data/andromedaSettings';
import { formatDate, getPostCover, getPublishedPosts } from '../../utils/posts';
import { themes } from '../../utils/themes';

const [latest] = await getPublishedPosts();
const cover = latest && (latest.data.gallery[0] || getPostCover(latest, 'andromeda'));
const journalHeading = ['garden', 'paper', 'night'].includes(site.theme);
---

<BaseLayout title="테마 미리보기" description="블로그에 적용할 수 있는 테마를 미리 확인하세요." noindex>
  <div class="shell page-shell theme-gallery-page">
    <header class="page-heading">
      {journalHeading && <p class="eyebrow">FIND YOUR STYLE</p>}
      <h1>테마 미리보기{journalHeading && <span class="brand-dot">.</span>}</h1>
      <p>테마를 선택하면 피드와 글 상세 화면을 미리 볼 수 있습니다.</p>
    </header>
    <div class="theme-gallery">
      {themes.map((theme) => (
        <a class="theme-option" href={`/themes/${theme.id}/feed/`}>
          {theme.id === 'andromeda' ? (
            <div class="andromeda-sample" aria-hidden="true">
              <div class="mini-header">
                <span class="mini-search"><AndromedaIcon name="search" /></span>
                <AndromedaIcon name="home" /><AndromedaIcon name="menu" />
              </div>
              <div class:list={['mini-columns', { 'profile-right': andromeda.sidebarRight }]}>
                <div class="mini-profile">
                  <div class="mini-banner">
                    {andromeda.banner && <img src={andromeda.banner} alt="" loading="lazy" />}
                  </div>
                  <span class="mini-avatar">{andromeda.avatar ? <img src={andromeda.avatar} alt="" loading="lazy" /> : site.title.slice(0, 1)}</span>
                  <strong>{site.title}</strong>
                  <span>@{andromeda.handle}</span>
                </div>
                {latest && <div class="mini-post">
                  <b>{site.title}</b>
                  {cover && <img src={cover} alt="" loading="lazy" />}
                  <strong>{latest.data.title}</strong>
                  <span>{latest.data.description}</span>
                </div>}
              </div>
            </div>
          ) : theme.id === 'astro-blog' || theme.id === 'astro-paper' ? (
            <div class="theme-sample astro-sample" data-theme={theme.id} aria-hidden="true">
              <div class="sample-nav"><strong>{site.title}<span>.</span></strong></div>
              <div class="astro-sample-intro">
                <strong>{site.headline}</strong>
                <p>{site.introduction}</p>
              </div>
              <b>최근 글</b>
              {latest && <div class="astro-sample-post">
                {theme.id === 'astro-blog' && latest.data.cover && <img src={latest.data.cover} alt="" loading="lazy" />}
                <strong>{latest.data.title}</strong>
                <small>{formatDate(latest.data.pubDate)}</small>
              </div>}
            </div>
          ) : <div class="theme-sample" data-theme={theme.id} aria-hidden="true">
            <div class="sample-nav"><strong>{site.title}<span>.</span></strong><span>글 &nbsp; 소개</span></div>
            <div class="sample-hero">
              <span>A PERSONAL JOURNAL</span>
              <strong>{site.headline}</strong>
              <i></i>
            </div>
            <div class="sample-lines"><span></span><span></span><span></span></div>
          </div>}
          <div class="theme-option-copy"><h2>{theme.name}</h2><p>{theme.description}</p><span>미리보기</span></div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  :global(.andromeda-main) .theme-gallery-page > .page-heading { margin: 0 0 24px; }
  :global(.andromeda-main) .theme-gallery {
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 16px;
    max-width: none;
  }
  :global(.andromeda-main) .theme-option { border-radius: 5px; }
  :global(.andromeda-main) .theme-option-copy { padding: 15px; }
  :global(.andromeda-main) .theme-option-copy p { min-height: 0; }
  .astro-sample { height: 210px; overflow: hidden; font-family: Arial, 'Noto Sans KR', sans-serif; }
  .astro-sample .sample-nav { padding-bottom: 8px; }
  .astro-sample-intro { margin-block: 12px; }
  .astro-sample-intro > strong { font-size: .95rem; line-height: 1.2; }
  .astro-sample-intro p, .astro-sample-post small { margin: 4px 0 0; font-size: .53rem; }
  .astro-sample > b, .astro-sample-post strong { display: block; font-size: .66rem; }
  .astro-sample-post { margin-top: 5px; }
  .astro-sample-post small { display: block; color: var(--muted); }
  .astro-sample-post img { width: 100%; max-height: 30px; margin-bottom: 4px; object-fit: cover; }
  .astro-sample[data-theme='astro-blog'] .astro-sample-post { text-align: center; }
  .astro-sample[data-theme='astro-paper'] { font-family: 'Google Sans Code', 'Noto Sans KR', monospace; }
  .astro-sample[data-theme='astro-paper'] .astro-sample-intro { border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .astro-sample[data-theme='astro-paper'] .astro-sample-post strong { color: var(--accent); }
  .andromeda-sample {
    height: 210px;
    overflow: hidden;
    padding: 0 7%;
    color: #c0c0c0;
    background: #141518;
    font: 8px/1.5 'Libre Franklin', 'Noto Sans KR', sans-serif;
  }
  .mini-header, .mini-profile, .mini-post {
    overflow: hidden;
    border: 1px solid #292c33;
    border-radius: 3px;
    background: #1d1f24;
  }
  .mini-header { display: flex; height: 24px; align-items: center; gap: 4px; padding: 0 6px; }
  .mini-header :global(svg) { width: 8px; height: 8px; }
  .mini-search { width: 28%; margin-right: auto; padding: 1px 4px; border-radius: 8px; background: #141518; }
  .mini-columns { display: grid; grid-template-columns: 35fr 60fr; align-items: start; gap: 5%; margin-top: 5%; }
  .mini-columns.profile-right { grid-template-columns: 60fr 35fr; }
  .profile-right .mini-profile { order: 2; }
  .mini-profile { padding: 2px 2px 6px; }
  .mini-banner { aspect-ratio: 1; overflow: hidden; background: linear-gradient(147deg, #ff99b8, #72b8e0); }
  .mini-banner img, .mini-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mini-avatar {
    position: relative; display: grid; place-items: center; width: 24%; aspect-ratio: 1;
    margin: -12% 5px 3px; overflow: hidden; border: 2px solid #1d1f24;
    border-radius: 50%; color: #f4c1d7; background: #34303d;
  }
  .mini-profile strong, .mini-profile > span:last-child, .mini-post strong, .mini-post > span { display: block; margin: 1px 5px; }
  .mini-post { padding-bottom: 7px; }
  .mini-post b { display: table; margin: 4px; padding: 1px 3px; border-radius: 2px; background: #141518; }
  .mini-post img { display: block; width: 100%; height: auto; margin-bottom: 4px; }
</style>
